    {
      "name": "A. CRUD",
      "item": [
        {
          "name": "GET Semua Ruang Kelas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response berupa array\", function () {\r\n    pm.expect(pm.response.json()).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Minimal ada 3 data awal\", function () {\r\n    pm.expect(pm.response.json().length).to.be.at.least(3);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/classrooms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "classrooms"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Ruang Kelas Berdasarkan ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Data memiliki field yang diperlukan\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data).to.have.property(\"id\");\r\n    pm.expect(data).to.have.property(\"kodeRuang\");\r\n    pm.expect(data).to.have.property(\"gedung\");\r\n    pm.expect(data).to.have.property(\"kapasitas\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/classrooms/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "classrooms",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Tambah Ruang Kelas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Data baru berhasil dibuat\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data).to.have.property(\"id\");\r\n    pm.expect(data.kodeRuang).to.eql(\"S-2428240072\");\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.environment.set(\"classroomId\", data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"kodeRuang\": \"S-2428240072\",\r\n  \"gedung\": \"S\",\r\n  \"lantai\": 4,\r\n  \"kapasitas\": 40,\r\n  \"adaProyektor\": true\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/classrooms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "classrooms"
              ]
            }
          },
          "response": []
        },
        {
          "name": "PUT Ubah Ruang Kelas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Data berhasil diperbarui\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.kapasitas).to.eql(45);\r\n    pm.expect(data.kodeRuang).to.eql(\"S-2428240072\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"kodeRuang\": \"S-2428240072\",\r\n  \"gedung\": \"S\",\r\n  \"lantai\": 4,\r\n  \"kapasitas\": 45,\r\n  \"adaProyektor\": true\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/classrooms/{{classroomId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "classrooms",
                "{{classroomId}}"
              ]
            }
          },
          "response": []
        },
